{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"migrations/**/*.ts\"",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate migrations/$npm_config_name",
    "migration:create": "typeorm-ts-node-commonjs migration:create migrations/$npm_config_name",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "seeder:run": "ts-node --transpile-only src/database/seed/seed.ts",
    "db:deploy": "pnpm migration:run",
    "db:migrate": "pnpm migration:run",
    "db:seed": "pnpm seeder:run",
    "db:reset": "ts-node --transpile-only src/database/seed/reset.ts && pnpm migration:run && pnpm seeder:run"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "3.0.2",
    "class-transformer": "~0.5.1",
    "class-validator": "~0.14.4",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "file-type": "16.5.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^6.10.1",
    "pdfjs-dist": "3.11.174",
    "pg": "^8.23.1",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "~0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "~0.33.5",
    "typeorm": "~0.3.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pdfkit": "~0.15.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3"
  }
}
