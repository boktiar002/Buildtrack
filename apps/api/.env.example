# ---- Required ----
DATABASE_URL=postgresql://buildtrack:buildtrack@localhost:5432/buildtrack
# Long random strings (at least 16 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-1
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-2

# ---- App ----
# Developer (organization) that self-registered buyers join
DEFAULT_ORG_SLUG=pipra
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Set to true when the site runs on HTTPS (production)
COOKIE_SECURE=false
DB_SSL=false
LOG_LEVEL=info

# ---- Files (photos and documents are stored on disk here) ----
STORAGE_DIR=./storage

# ---- AI ----
# mock = works offline with no key (good for development and demos)
# gemini = real AI using Google's Gemini API
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_TIMEOUT_MS=45000
GEMINI_THINKING_LEVEL=low
AI_MAX_RETRIES=2

# ---- Email (optional: without SMTP_HOST, emails are printed to the console) ----
# For local testing, run any SMTP sandbox (e.g. Mailpit) on port 1025 and set SMTP_HOST=127.0.0.1
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BuildTrack <no-reply@buildtrack.local>"
SMS_PROVIDER=console

SCHEDULER_ENABLED=true
